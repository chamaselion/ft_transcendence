# To test this project you should run 'cp `.env.example .env`
# Then set JWT_SECRET to a generated hash.
# Generate a new JWT secret with:
# openssl rand -hex 32
# Copy the printed random line and replace `generate_with_openssl` with it.
# Run `make up`
# To stop run `make down`, to clear out created volumes, images, containers use `make clear`

JWT_SECRET=generate_with_openssl

PORT=3001
BACKEND_HOST_PORT=3001
DB_HOST_PORT=5433


DB_RETRY_LIMIT=10
DB_RETRY_DELAY_MS=2000

DATABASE_URL=postgres://ft_user:change_me@db:5432/ft_transcendence
NODE_ENV=development

BCRYPT_SALT_ROUNDS=10
JWT_EXPIRES_IN=7d

POSTGRES_DB=ft_transcendence
POSTGRES_USER=ft_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# For development set EMAIL_TRANSPORT=console for getting 2FA codes printed out
# For "production" it will be set to =smtp to actually send emails.

EMAIL_TRANSPORT=console
EMAIL_FROM=example@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=transendence053@gmail.com
# Gmail/SMTP app password (no spaces). Required when SMTP_USER is set.
SMTP_PASS=replace_with_mail_app_password

ONE_TIME_CODE_LENGTH=6
ONE_TIME_CODE_MAX_ATTEMPTS=3
ONE_TIME_CODE_TTL_MS=600000
