# To test this project you should run 'cp `.env.example .env`
# Then set JWT_SECRET to a generated hash.
# Generate a new JWT secret with:
# openssl rand -hex 32
# Copy the printed random line and replace `generate_with_openssl` with it.
# Run `make up` (or `make dev`) for the dev server.
# Run `make prod` to build and serve the finished production bundle.
# To stop run `make down`, to clear out created volumes, images, containers use `make clear`

JWT_SECRET=generate_with_openssl

PORT=3001
BACKEND_HOST_PORT=3001
DB_HOST_PORT=5433

# nginx (single entry point) - development (`make dev`).
# Access the app at https://localhost:${HTTPS_HOST_PORT}
HTTPS_HOST_PORT=8443
HTTP_HOST_PORT=8080

# nginx (single entry point) - production (`make prod`).
# Defaults to the standard web ports so the bundle works without a port suffix.
PROD_HTTPS_HOST_PORT=443
PROD_HTTP_HOST_PORT=80


DB_RETRY_LIMIT=10
DB_RETRY_DELAY_MS=2000

DATABASE_URL=postgres://ft_user:change_me@db:5432/ft_transcendence
NODE_ENV=development

BCRYPT_SALT_ROUNDS=10
JWT_EXPIRES_IN=7d

POSTGRES_DB=ft_transcendence
POSTGRES_USER=ft_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# For development set EMAIL_TRANSPORT=console for getting 2FA codes printed out
# For "production" it will be set to =smtp to actually send emails.

EMAIL_TRANSPORT=console
EMAIL_FROM=example@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=transendence053@gmail.com
# Gmail/SMTP app password (no spaces). Required when SMTP_USER is set.
SMTP_PASS=replace_with_mail_app_password

ONE_TIME_CODE_LENGTH=6
ONE_TIME_CODE_MAX_ATTEMPTS=3
ONE_TIME_CODE_TTL_MS=600000

#OAUTH 2.0
# Values are placeholders and must be replaced with real app credentials.
OAUTH_GITHUB_CLIENT_ID=replace_with_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=replace_with_github_client_secret
OAUTH_GITHUB_REDIRECT_URI=https://localhost:8443/api/auth/oauth/github/callback
OAUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
OAUTH_GITHUB_USERINFO_URL=https://api.github.com/user

OAUTH_42_CLIENT_ID=replace_with_42_uid
OAUTH_42_CLIENT_SECRET=replace_with_42_secret
OAUTH_42_REDIRECT_URI=https://localhost:8443/api/auth/oauth/42/callback
OAUTH_42_AUTHORIZE_URL=https://api.intra.42.fr/oauth/authorize
OAUTH_42_TOKEN_URL=https://api.intra.42.fr/oauth/token
OAUTH_42_USERINFO_URL=https://api.intra.42.fr/v2/me

ADMIN_EMAIL=test@gmail.com

#RUSTFS/S3
RUSTFS_ADMIN_ACCESS_KEY=replace_with_a_admin_username
RUSTFS_ADMIN_SECRET_KEY=replace_with_rustfs_admin_secret_key
#Docker internal network
S3_ENDPOINT=http://obj-storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=<application-access-key>
S3_SECRET_KEY=<application-secret-key>
S3_BUCKET=<bucket-name>

# AI Translation Service (openai | deepseek | anthropic | mock)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=replace_with_ai_api_key
AI_BASE_URL=
AI_TIMEOUT_MS=15000
