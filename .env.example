PORT=3001
DB_RETRY_LIMIT=10
DB_RETRY_DELAY_MS=2000

DATABASE_URL=postgres://ft_user:change_me@db:5432/ft_transcendence
# Sets CORS settings, use only "=development". Option "=production" is still to be considered if needed for our case.
NODE_ENV=development

# Generate a new JWT secret with:
# openssl rand -hex 32
JWT_SECRET=generate_with_openssl

BCRYPT_SALT_ROUNDS=10
JWT_EXPIRES_IN=7d

# Email delivery for one-time codes.
# Use EMAIL_TRANSPORT=console for local development or EMAIL_TRANSPORT=smtp for Gmail SMTP.
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@transcendence.local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password

# One-time code defaults.
ONE_TIME_CODE_LENGTH=6
ONE_TIME_CODE_MAX_ATTEMPTS=3
ONE_TIME_CODE_TTL_MS=600000

POSTGRES_DB= #For exmaple: ft_transcendence
POSTGRES_USER= #For exmaple: ft_user
POSTGRES_PASSWORD= #For exmaple: ft_pass

BACKEND_HOST_PORT= #For exmaple: 3001
DB_HOST_PORT= #For exmaple: 5432
NGINX_HOST_PORT= #For exmaple: 8080

API_BASE_URL=http://localhost:3001