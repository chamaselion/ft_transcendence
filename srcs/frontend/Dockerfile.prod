# Production frontend image.
#
# Stage 1 builds the SPA with Vite, stage 2 serves the resulting static
# files with nginx on 8081. The main nginx service keeps proxying "/" to
# frontend:8081, so the architecture is identical to the dev stack.

# ----- Build stage -----
FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY transcendence-spa/package.json transcendence-spa/package-lock.json ./
RUN npm ci

COPY transcendence-spa/ ./
RUN npm run build

# ----- Serve stage -----
FROM nginx:1.27-alpine AS serve

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8081

CMD ["nginx", "-g", "daemon off;"]
